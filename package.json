{
	"name": "blog-cms",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3000",
		"generate-routes": "tsr generate",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"format": "biome format",
		"lint": "biome lint",
		"check-types": "tsc --noEmit",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"deploy": "bun run build && wrangler deploy",
		"deploy:check": "bun run scripts/deploy-check.ts",
		"deploy:preview": "bun run build && wrangler deploy",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply blog-cms --local --persist-to \"${CLOUDFLARE_LOCAL_STATE_PATH:-${XDG_RUNTIME_DIR:-/tmp}/contentos-wrangler-state}\"",
		"db:migrate:remote": "wrangler d1 migrations apply blog-cms --remote",
		"db:studio:local": "state=\"${CLOUDFLARE_LOCAL_STATE_PATH:-${XDG_RUNTIME_DIR:-/tmp}/contentos-wrangler-state}\"/v3/d1/miniflare-D1DatabaseObject; for database in \"$state\"/*.sqlite; do [ \"$database\" = \"$state/metadata.sqlite\" ] && continue; DATABASE_URL=\"$database\" drizzle-kit studio; exit $?; done; printf 'No local D1 database found. Run bun run db:migrate first.\\n' >&2; exit 1",
		"db:studio:remote": "drizzle-kit studio --config=drizzle.remote.config.ts",
		"release": "release-it",
		"release:beta": "release-it --preRelease=beta",
		"prepare": "lefthook install"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@cloudflare/vite-plugin": "^1.26.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@t3-oss/env-core": "^0.13.10",
		"@tabler/icons-react": "^3.45.0",
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-devtools": "latest",
		"@tanstack/react-form": "latest",
		"@tanstack/react-query": "latest",
		"@tanstack/react-query-devtools": "latest",
		"@tanstack/react-router": "latest",
		"@tanstack/react-router-devtools": "latest",
		"@tanstack/react-router-ssr-query": "latest",
		"@tanstack/react-start": "latest",
		"@tanstack/router-plugin": "^1.132.0",
		"@tiptap/extension-placeholder": "^3.31.3",
		"@tiptap/react": "^3.31.3",
		"@tiptap/starter-kit": "^3.31.3",
		"aws4fetch": "^1.0.20",
		"better-auth": "^1.5.3",
		"better-sqlite3": "^12.6.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.9",
		"drizzle-orm": "^0.45.1",
		"motion": "^12.42.2",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"shadcn": "^4.13.1",
		"tailwind-merge": "^3.0.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.3.6",
		"zod": "^4.5.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@release-it/conventional-changelog": "^12.0.2",
		"@rolldown/plugin-babel": "^0.2.3",
		"@tailwindcss/typography": "^0.5.16",
		"@tanstack/devtools-vite": "latest",
		"@tanstack/router-cli": "^1.132.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.0",
		"@types/better-sqlite3": "^7.6.0",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"dotenv": "^17.3.1",
		"jsdom": "^28.1.0",
		"lefthook": "^2.1.14",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^4.1.5",
		"wrangler": "^4.70.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss",
			"better-sqlite3"
		]
	},
	"packageManager": "bun@1.4.2"
}
