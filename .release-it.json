{
	"git": {
		"commitMessage": "chore(release): v${version}",
		"tagName": "v${version}",
		"tagAnnotation": "ContentOS v${version}",
		"requireCleanWorkingDir": true,
		"requireUpstream": true
	},
	"github": {
		"release": true,
		"releaseName": "ContentOS v${version}",
		"preRelease": false
	},
	"npm": {
		"publish": false
	},
	"plugins": {
		"@release-it/conventional-changelog": {
			"preset": {
				"name": "conventionalcommits",
				"types": [
					{
						"type": "feat",
						"section": "✨ Features"
					},
					{
						"type": "fix",
						"section": "🐛 Bug Fixes"
					},
					{
						"type": "refactor",
						"section": "♻️ Refactoring"
					},
					{
						"type": "chore",
						"section": "🔧 Maintenance"
					},
					{
						"type": "build",
						"section": "🏗️ Build"
					}
				]
			},
			"infile": "CHANGELOG.md",
			"header": "# ContentOS Changelog\n\n"
		}
	}
}
