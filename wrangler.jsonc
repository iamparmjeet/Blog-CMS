{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "blog-cms",
	"compatibility_date": "2025-09-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "src/server.ts",
	"triggers": {
		"crons": ["*/5 * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "blog-cms",
			"database_id": "142c33e3-399b-4eea-9164-10995ce4f115",
			"migrations_dir": "src/db/drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "contentos",
			"remote": true
		}
	]
}
